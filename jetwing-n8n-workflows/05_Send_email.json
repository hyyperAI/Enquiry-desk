      "parameters": {
        "operation": "executeQuery",
        "query": "with ins as (\n  insert into send_log (idempotency_key, enquiry_id, send_type)\n  values ($1, nullif($2, '')::uuid, $3) on conflict do nothing returning 1)\nselect (select count(*) from ins) > 0 as claimed, s.test_mode, s.test_email\nfrom agent_settings s where s.id = 1;",
        "options": {
          "queryReplacement": "={{ [ $json.idempotency_key, $json.enquiry_id ?? '', $json.send_type ] }}"
        }
