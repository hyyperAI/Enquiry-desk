      "parameters": {
        "operation": "executeQuery",
        "query": "select d.id, d.status, d.enquiry_id, d.gmail_draft_id, d.subject,\n  coalesce(nullif($2, ''), d.body_html) as body_html, c.email as to_email,\n  (select m.gmail_thread_id from email_messages m where m.enquiry_id = d.enquiry_id and m.status in ('received','sent')\n   order by m.message_at desc limit 1) as gmail_thread_id,\n  (select m.rfc_message_id from email_messages m where m.enquiry_id = d.enquiry_id and m.direction = 'inbound'\n   order by m.message_at desc limit 1) as in_reply_to,\n  exists (select 1 from email_messages m where m.enquiry_id = d.enquiry_id and m.direction = 'inbound'\n          and m.created_at > d.created_at) as newer_inbound\nfrom email_messages d join enquiries e on e.id = d.enquiry_id join contacts c on c.id = e.contact_id\nwhere d.id = $1::uuid and d.direction = 'outbound';",
        "options": {
          "queryReplacement": "={{ [ $json.body.draft_id, $json.body.body_html ?? '' ] }}"
        }
      },
