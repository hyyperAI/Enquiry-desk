    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with f as (\n  update followups set status = 'processing', message_body = coalesce(nullif($2, ''), message_body)\n  where id = $1::uuid and status = 'due' and message_body is not null returning *)\nselect f.id, f.enquiry_id, f.message_body, c.email as to_email, e.subject,\n  (select m.gmail_thread_id from email_messages m where m.enquiry_id = f.enquiry_id and m.status in ('received','sent')\n   order by m.message_at desc limit 1) as gmail_thread_id,\n  (select m.rfc_message_id from email_messages m where m.enquiry_id = f.enquiry_id and m.direction = 'inbound'\n   order by m.message_at desc limit 1) as in_reply_to\nfrom f join enquiries e on e.id = f.enquiry_id join contacts c on c.id = e.contact_id;",
        "options": {
          "queryReplacement": "={{ [ $json.body.followup_id, $json.body.body_html ?? '' ] }}"
        }
      },
