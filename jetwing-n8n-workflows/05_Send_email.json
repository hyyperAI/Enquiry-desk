      "id": "f6f50929-cd9c-4c26-835c-a184f215d6c5",
      "name": "Download attachment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1008,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "notes": "Why HTTP: the Supabase node has no Storage download operation.",
      "credentials": {
        "supabaseApi": {
          "id": "bnOGoD90bozQRp9X",
          "name": "flag"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Why Code: the Gmail node cannot send to a chosen address inside an existing thread with an optional attachment in one operation\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const inp = $('When Executed by Another Workflow').itemMatching(i).json;\n  const claim = $('Claim send key').itemMatching(i).json;\n  const test = claim.test_mode === true;\n  const to = test ? claim.test_email : inp.to;\n  if (!to) throw new Error(test ? 'Test mode is on but agent_settings.test_email is empty' : 'No recipient');\n  const subject = test ? `[TEST to ${inp.to}] ${inp.subject ?? ''}` : (inp.subject ?? '');\n  const b64 = s => Buffer.from(s, 'utf8').toString('base64');\n  const wrap = s => s.replace(/.{76}/g, '$&\\r\\n');\n  const headers = [`To: ${to}`, `Subject: =?UTF-8?B?${b64(subject)}?=`, 'MIME-Version: 1.0'];\n  if (!test && inp.in_reply_to) headers.push(`In-Reply-To: ${inp.in_reply_to}`, `References: ${inp.in_reply_to}`);\n  const htmlPart = ['Content-Type: text/html; charset=\"UTF-8\"', 'Content-Transfer-Encoding: base64', '', wrap(b64(inp.body_html ?? ''))].join('\\r\\n');\n  let mime;\n  if (inp.attachment_path) {\n    const bin = items[i].binary?.data;\n    if (!bin) throw new Error('Attachment download returned no file');\n    const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n    const name = inp.attachment_path.split('/').pop();\n    const boundary = 'jw_' + Math.random().toString(36).slice(2);\n    mime = [...headers, `Content-Type: multipart/mixed; boundary=\"${boundary}\"`, '',\n      `--${boundary}`, htmlPart, '',\n      `--${boundary}`, `Content-Type: ${bin.mimeType || 'application/pdf'}; name=\"${name}\"`,\n      `Content-Disposition: attachment; filename=\"${name}\"`, 'Content-Transfer-Encoding: base64', '',\n      wrap(buf.toString('base64')), '', `--${boundary}--`].join('\\r\\n');\n  } else {\n    mime = [...headers, htmlPart].join('\\r\\n');\n  }\n  out.push({ json: { raw: Buffer.from(mime).toString('base64url'),\n                     threadId: test ? null : (inp.gmail_thread_id || null), to, subject, is_test: test } });\n}\nreturn out;"
      },
      "id": "d921fed2-25d5-4bee-a457-49c663737db2",
