    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with requeued as (\n  update outbox set status = 'queued'\n  where status = 'processing' and channel = 'email' and kind in ('reply','quotation')\n    and coalesce(processed_at, created_at) < now() - interval '15 minutes'\n  returning id),\nclaimed as (\n  update outbox o set status = 'processing', processed_at = now(), last_error = null\n  where o.id in (select q.id from outbox q\n                 where q.status = 'queued' and q.channel = 'email' and q.kind in ('reply','quotation')\n                 order by q.created_at limit 10 for update skip locked)\n  returning o.*)\nselect c.id as outbox_id, c.kind, c.enquiry_id, c.quotation_id, c.to_address, c.created_by,\n  coalesce(c.body, '') as body,\n  coalesce(nullif(c.subject, ''), 'Re: ' || coalesce(e.subject, 'Your enquiry')) as subject,\n  (select m.gmail_thread_id from email_messages m where m.enquiry_id = c.enquiry_id and m.status in ('received','sent')\n   order by m.message_at desc nulls last limit 1) as gmail_thread_id,\n  (select m.rfc_message_id from email_messages m where m.enquiry_id = c.enquiry_id and m.direction = 'inbound'\n   order by m.message_at desc nulls last limit 1) as in_reply_to,\n  (select d.id from email_messages d where d.id = c.email_message_id and d.status = 'draft') as draft_row_id,\n  (select d.gmail_draft_id from email_messages d where d.id = c.email_message_id and d.status = 'draft') as gmail_draft_id,\n  (select count(*) from requeued) as requeued_count\nfrom claimed c left join enquiries e on e.id = c.enquiry_id\norder by c.created_at;",
        "options": {}
      },
