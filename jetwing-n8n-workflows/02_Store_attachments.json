      "retryOnFail": true,
      "maxTries": 3,
      "webhookId": "e316168d-faa3-4498-9623-2e824cd7f2bb",
      "credentials": {
        "gmailOAuth2": {
          "id": "8r3EnLHhGZ6HmYZU",
          "name": "exopai"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Why Code: no native node turns several binary properties on one item into one item per file\nconst ALLOWED = /^(application\\/pdf|image\\/(png|jpe?g|gif|webp|heic)|application\\/msword|application\\/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document)$/i;\nconst MAX = 15 * 1024 * 1024;\nconst inp = $('When Executed by Another Workflow').first().json;\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  for (const [key, bin] of Object.entries(items[i].binary ?? {})) {\n    if (!ALLOWED.test(bin.mimeType ?? '')) continue;\n    const buf = await this.helpers.getBinaryDataBuffer(i, key);\n    if (buf.length > MAX) continue;\n    const safe = (bin.fileName || key).replace(/[^\\w.\\-]+/g, '_').slice(-120);\n    out.push({\n      json: { enquiry_id: inp.enquiry_id, message_row_id: inp.message_row_id, file_name: bin.fileName || key,\n              mime_type: bin.mimeType, size_bytes: buf.length,\n              storage_path: `${inp.enquiry_id}/${inp.message_row_id}/${out.length}_${safe}` },\n      binary: { data: bin },\n    });\n  }\n}\nreturn out;"
      },
      "id": "4e1cab30-4735-482b-b2bc-97deacf945f2",
