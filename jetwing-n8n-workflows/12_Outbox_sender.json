    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with o as (\n  update outbox set status = 'sent', processed_at = now(), last_error = null\n  where id = $1::uuid and status = 'processing' returning *),\nm as (\n  update email_messages em set body_text = o.body from o\n  where em.id = nullif($2, '')::uuid returning em.id),\ne as (\n  update enquiries en set status = 'quotation_sent' from o\n  where en.id = o.enquiry_id and en.status = 'new' returning en.id)\nselect (select count(*) from o) as marked_sent, (select count(*) from m) as text_saved,\n  jw_schedule_followup((select enquiry_id from o), 'reply') as followup_id;",
        "options": {
          "queryReplacement": "={{ [ $('Claim outbox rows').item.json.outbox_id, $json.email_message_id || $('Claim outbox rows').item.json.draft_row_id || '' ] }}"
        }
      },
