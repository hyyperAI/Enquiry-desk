      "id": "610a1fa1-b56d-4a8f-8589-ebf20922cfdd",
      "name": "Extract plain text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1008,
        208
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Why Code: no native node splits long text into overlapping chunks\nconst text = String($json.text ?? $json.data ?? '').replace(/\\r/g, '').replace(/\\n{3,}/g, '\\n\\n').trim();\nif (!text) throw new Error('No text could be extracted from this file');\nconst SIZE = 1200, OVERLAP = 200, chunks = [];\nlet start = 0;\nwhile (start < text.length) {\n  let end = Math.min(start + SIZE, text.length);\n  if (end < text.length) { const cut = text.lastIndexOf('\\n', end); if (cut > start + SIZE / 2) end = cut; }\n  const piece = text.slice(start, end).trim();\n  if (piece) chunks.push(piece);\n  if (end >= text.length) break;\n  start = end - OVERLAP;\n}\nif (chunks.length > 120) throw new Error(`Document too long (${chunks.length} chunks). Split it into smaller files.`);\nreturn { json: { document_id: $('Webhook').first().json.body.document_id, chunks } };"
      },
      "id": "addd0b14-b426-4598-907b-d99a3686e7ac",
      "name": "Split into chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
